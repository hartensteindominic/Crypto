<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>HyperStream XD • Ultimate 4D + VR</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;height:100%;overflow:hidden;background:#020617;color:#f1f5f9;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
body{display:flex}
#sidebar{
  width:390px;min-width:300px;
  background:rgba(3,7,18,0.97);
  backdrop-filter:blur(20px);
  border-right:1px solid #1e293b;
  display:flex;flex-direction:column;
  padding:14px;gap:10px;
  overflow-y:auto;z-index:30;
}
.brand{font-size:14px;font-weight:900;color:#38bdf8;line-height:1.3}
.brand span{
  background:linear-gradient(90deg,#38bdf8,#ec4899,#8b5cf6,#10b981);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
}
.card{
  background:rgba(15,23,42,0.92);
  border:1px solid #334155;
  border-radius:14px;
  padding:12px;
  display:flex;flex-direction:column;gap:8px;
}
.title{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:#94a3b8}
.row{display:flex;justify-content:space-between;align-items:center;font-size:11px;gap:8px;color:#cbd5e1}
input[type=range]{accent-color:#ec4899;width:130px;cursor:pointer}
button{
  border:none;border-radius:9px;
  padding:10px 12px;font-size:11px;font-weight:800;
  cursor:pointer;color:#fff;transition:all .15s;
}
button:active{transform:scale(.97)}
.btn-main{background:linear-gradient(135deg,#8b5cf6,#ec4899)}
.btn-danger{background:#ef4444;width:100%}
.btn-danger.on{background:#f97316;animation:pulse 1.4s infinite}
.btn-secondary{background:#1e293b;border:1px solid #475569}
.btn-success{background:#10b981}
.btn-vr{background:linear-gradient(135deg,#6366f1,#ec4899)}
.tabs{display:flex;gap:6px}
.tab{
  flex:1;padding:9px;
  background:#1e293b;border:1px solid #334155;
  border-radius:9px;color:#94a3b8;
  font-size:11px;font-weight:700;cursor:pointer;
}
.tab.on{background:linear-gradient(135deg,#8b5cf6,#ec4899);color:#fff;border:none}
#viewer{flex:1;position:relative;background:#020617}
canvas{display:block;width:100%;height:100%}
.stats{
  position:absolute;top:14px;right:14px;
  background:rgba(2,6,23,0.9);
  backdrop-filter:blur(12px);
  padding:10px 14px;border-radius:12px;
  border:1px solid rgba(255,255,255,0.1);
  font-size:11px;color:#94a3b8;z-index:20;
}
.stats b{color:#ec4899}
.chips{display:flex;flex-wrap:wrap;gap:5px}
.chip{
  font-size:10px;padding:4px 8px;border-radius:7px;
  background:#1e293b;border:1px solid #475569;cursor:pointer;
}
.chip.on{background:#ec4899;border-color:#db2777;color:#fff}
textarea{
  width:100%;height:52px;
  background:#0f172a;border:1px solid #334155;
  border-radius:9px;color:#f8fafc;
  font-size:10px;padding:8px;resize:none;
}
.drop{
  border:1.5px dashed #475569;padding:16px;
  border-radius:12px;text-align:center;
  font-size:11px;cursor:pointer;color:#94a3b8;
}
.drop.over{border-color:#ec4899;background:rgba(236,72,153,0.1)}
input[type=file]{display:none}
.prog{height:6px;background:#1e293b;border-radius:4px;overflow:hidden;margin-top:6px}
.prog>div{height:100%;background:linear-gradient(90deg,#38bdf8,#ec4899);width:0%;transition:width .15s}
.hint{font-size:10px;color:#94a3b8;line-height:1.4}
.toast{
  position:fixed;left:50%;bottom:24px;
  transform:translateX(-50%);z-index:60;
  padding:12px 20px;border-radius:999px;
  background:#020617f0;border:1px solid #ffffff22;
  font-size:12px;opacity:0;transition:.25s;
}
.toast.show{opacity:1}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.65}}
@media(max-width:900px){
  #sidebar{
    position:fixed;left:0;top:0;bottom:0;
    transform:translateX(-100%);
    width:min(380px,94vw);
    transition:transform .25s;z-index:40;
  }
  #sidebar.open{transform:translateX(0)}
  #toggleSidebar{display:flex}
}
#toggleSidebar{
  display:none;position:fixed;top:14px;left:14px;z-index:50;
  width:44px;height:44px;border-radius:50%;
  background:rgba(15,23,42,0.95);border:1px solid #475569;
  color:#fff;font-size:20px;
  align-items:center;justify-content:center;cursor:pointer;
}
</style>
</head>
<body>
<button id="toggleSidebar" onclick="document.getElementById('sidebar').classList.toggle('open')">☰</button>

<div id="sidebar">
  <div class="brand">HYPERSTREAM XD<br><span>4D HOLOGRAPHIC + VR</span></div>

  <div class="tabs">
    <button class="tab on" id="t-cap" onclick="mode('cap')">Live 4D</button>
    <button class="tab" id="t-load" onclick="mode('load')">Load</button>
  </div>

  <div class="card" id="p-cap">
    <div class="title">Quantum Volumetric Scan</div>
    <button class="btn-danger" id="scanBtn" onclick="toggleScan()">ACTIVATE 4D MATRIX SCAN</button>
    <div style="display:flex;gap:8px">
      <button class="btn-secondary" style="flex:1" id="camBtn" onclick="switchCam()">Front Cam</button>
      <button class="btn-secondary" style="flex:1" id="perfBtn" onclick="togglePerf()">Warp</button>
    </div>
    <div class="row"><span>Voxel Density</span><input type="range" id="step" min="1" max="3" value="2" oninput="stepSize=+this.value;$('stepV').textContent=this.value;saveSettings()"><span id="stepV">2</span></div>
    <div class="row"><span>Hyper-Depth</span><input type="range" id="depth" min="10" max="140" value="85" oninput="depthMul=+this.value;saveSettings()"></div>
    <div class="row"><span>Node Size</span><input type="range" id="psize" min="0.005" max="0.07" value="0.014" step="0.001" oninput="ptSize=+this.value;updSize();saveSettings()"></div>
    <div class="row"><span>Strata</span><input type="range" id="layers" min="2" max="24" value="14" oninput="layerN=+this.value;$('layV').textContent=this.value;buildChips();saveSettings()"><span id="layV">14</span></div>
    <div class="row"><span>Dispersion</span><input type="range" id="spread" min="0.2" max="4" value="1.6" step="0.05" oninput="layerSp=+this.value;saveSettings()"></div>
    <div style="font-size:10px;color:#94a3b8">Voxels <b id="nLive">0</b> · Frames <b id="nFrm">0</b></div>
    <div style="display:flex;gap:8px">
      <button class="btn-success" style="flex:1" onclick="expJSON()">Export JSON</button>
      <button class="btn-secondary" style="flex:1" onclick="copyJSON()">Copy</button>
    </div>
    <textarea id="jsonOut" readonly placeholder="4D stream data..."></textarea>
  </div>

  <div class="card" id="p-load" style="display:none">
    <div class="title">Import Matrix</div>
    <div class="drop" id="drop" onclick="$('fi').click()">Drop JSON or Click to Browse
      <input type="file" id="fi" accept=".json" onchange="fileIn(event)">
    </div>
    <button class="btn-secondary" onclick="clearAll()">Purge Environment</button>
  </div>

  <div class="card">
    <div class="title">Render & Motion</div>
    <div class="row"><span>Engine</span>
      <select id="rmode" onchange="rMode=this.value;if(frames.length)drawFrame(playIdx,metaV)">
        <option value="points">Point Matrix</option>
        <option value="solid">Crystalline</option>
        <option value="wire">Wireframe</option>
        <option value="quantumWave">Quantum Wave</option>
        <option value="plasmaVortex">Plasma Vortex</option>
      </select>
    </div>
    <div class="row"><span>Bloom</span><input type="range" id="bloomInt" min="0" max="3" value="1.3" step="0.1" oninput="if(bloomPass)bloomPass.strength=+this.value"></div>
    <div class="row"><span>Warp</span><input type="range" id="meta" min="0" max="100" value="40" oninput="metaV=this.value/100;$('metaV').textContent=metaV.toFixed(2)"><span id="metaV">0.40</span></div>
    <div class="row"><span>Timeline</span><input type="range" id="scrub" min="0" max="0" value="0" oninput="playIdx=+this.value;if(frames.length)drawFrame(playIdx,metaV)"><span id="scrubV">0/0</span></div>
    <div style="display:flex;gap:8px">
      <button class="btn-secondary" style="flex:1" id="playBtn" onclick="togglePlay()">Play</button>
      <button class="btn-secondary" style="flex:1" onclick="resetCam()">Recenter</button>
    </div>
    <div class="row"><span>Auto Orbit</span><input type="checkbox" id="orbit" checked onchange="autoOrbit=this.checked"></div>
    <div class="row"><span>Pulse</span><input type="checkbox" id="pulse" checked onchange="doPulse=this.checked"></div>
    <div class="title" style="margin-top:6px">Strata Visibility</div>
    <div class="chips" id="chips"></div>
  </div>

  <div class="card">
    <div class="title">VR</div>
    <button class="btn-vr" id="vrBtn" onclick="toggleVR()">Enter Immersive VR</button>
    <div class="hint" id="xrHint">Checking WebXR...</div>
    <div class="hint" style="margin-top:6px">In VR: Hold trigger 0.6s to start/stop recording hologram</div>
  </div>

  <div class="card">
    <div class="title">Export</div>
    <button class="btn-main" style="background:#0d9488" onclick="expPNG()">Capture PNG</button>
    <button class="btn-main" style="background:#2563eb;margin-top:6px" id="webmBtn" onclick="expVideo()">Record 8s Video</button>
    <div class="prog"><div id="progFill"></div></div>
    <div class="hint" id="expStatus">Ready</div>
  </div>
</div>

<div id="viewer">
  <div class="stats">
    <span id="status">Core Engine Online</span><br>
    FPS <b id="fpsD">—</b> · Voxels <b id="nodesD">0</b>
  </div>
  <video id="vid" autoplay playsinline muted style="display:none"></video>
  <canvas id="c3"></canvas>
</div>

<div class="toast" id="toast"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/EffectComposer.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/RenderPass.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/CopyShader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js"></script>

<script>
const $ = id => document.getElementById(id);

// ===================== STATE =====================
let scene, cam, ren, ctrl, composer, bloomPass;
let layers = [], prevPos = [];
let video, c2d, ctx;
let scanning = false, rec = [], fIdx = 0;
let stepSize = 2, depthMul = 85, ptSize = 0.014;
let layerN = 14, layerSp = 1.6, smooth = 0.32;
let rMode = 'points', metaV = 0.4, playFPS = 24;
let isPlay = false, frames = [], playIdx = 0, lastT = 0;
let autoOrbit = true, doPulse = true, vis = [];
let facing = 'user', stream = null, ready = false;
let perf = false, lastVol = 0;
const VOL_MS = 33;
let fc = 0, ft = 0, phase = 0;
let exporting = false;
let controllers = [], holoRoot = null;
const grabState = { active: null, offset: new THREE.Vector3(), lastDist: 0 };
let stars = null;

// VR Recorder
let vrRecording = false;
let vrFrames = [];
let vrRecordInterval = null;
let vrIndicator = null;

// ===================== INIT =====================
window.addEventListener('DOMContentLoaded', () => {
  loadSettings();
  init3();
  initCam('user');
  dropInit();
  buildChips();
  checkXR();
});

function init3() {
  const box = $('viewer');
  scene = new THREE.Scene();
  scene.fog = new THREE.FogExp2(0x020617, 0.014);

  cam = new THREE.PerspectiveCamera(50, box.clientWidth / box.clientHeight, 0.05, 2000);
  cam.position.set(0, 0.6, 4.2);

  ren = new THREE.WebGLRenderer({
    canvas: $('c3'),
    antialias: true,
    powerPreference: 'high-performance',
    preserveDrawingBuffer: true
  });
  ren.setSize(box.clientWidth, box.clientHeight);
  ren.setPixelRatio(Math.min(devicePixelRatio || 1, 2));
  ren.setClearColor(0x020617);
  ren.xr.enabled = true;

  holoRoot = new THREE.Group();
  scene.add(holoRoot);

  createStars();
  createVRIndicator();

  composer = new THREE.EffectComposer(ren);
  composer.addPass(new THREE.RenderPass(scene, cam));
  bloomPass = new THREE.UnrealBloomPass(
    new THREE.Vector2(box.clientWidth, box.clientHeight), 1.3, 0.4, 0.85
  );
  composer.addPass(bloomPass);

  if (typeof THREE.OrbitControls === 'function') {
    ctrl = new THREE.OrbitControls(cam, ren.domElement);
    ctrl.enableDamping = true;
    ctrl.dampingFactor = 0.08;
    ctrl.autoRotate = true;
    ctrl.autoRotateSpeed = 0.3;
    ctrl.target.set(0, 0, 0);
  }

  const grid = new THREE.GridHelper(40, 40, 0xec4899, 0x0f172a);
  grid.position.y = -2.2;
  scene.add(grid);

  scene.add(new THREE.AmbientLight(0xffffff, 0.9));
  const l1 = new THREE.DirectionalLight(0x38bdf8, 1.5);
  l1.position.set(5, 8, 4);
  scene.add(l1);
  const l2 = new THREE.DirectionalLight(0xec4899, 1.2);
  l2.position.set(-5, -1, -4);
  scene.add(l2);

  // Controllers
  for (let i = 0; i < 2; i++) {
    const c = ren.xr.getController(i);
    c.userData.selecting = false;
    c.userData.holdTimer = null;
    c.addEventListener('selectstart', () => onSelectStart(c));
    c.addEventListener('selectend', () => onSelectEnd(c));
    scene.add(c);
    controllers.push(c);

    const geo = new THREE.BufferGeometry().setFromPoints([
      new THREE.Vector3(0,0,0),
      new THREE.Vector3(0,0,-0.5)
    ]);
    c.add(new THREE.Line(geo, new THREE.LineBasicMaterial({
      color: 0xec4899, transparent: true, opacity: 0.7
    })));
  }

  ren.xr.addEventListener('sessionstart', () => {
    $('vrBtn').textContent = 'Exit VR';
    $('status').textContent = 'Immersive VR Active';
    holoRoot.position.set(0, 1.3, -1.7);
    holoRoot.scale.setScalar(0.75);
  });

  ren.xr.addEventListener('sessionend', () => {
    $('vrBtn').textContent = 'Enter Immersive VR';
    $('status').textContent = 'Core Engine Online';
    holoRoot.position.set(0,0,0);
    holoRoot.scale.setScalar(1);
    releaseGrab();
    if (vrRecording) stopVRRecording();
  });

  window.addEventListener('resize', onResize);
  ren.setAnimationLoop(loop);
}

function createStars() {
  const geo = new THREE.BufferGeometry();
  const count = 1800;
  const pos = new Float32Array(count * 3);
  for (let i = 0; i < count * 3; i++) pos[i] = (Math.random() - 0.5) * 90;
  geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
  stars = new THREE.Points(geo, new THREE.PointsMaterial({
    color: 0xa5b4fc, size: 0.07, transparent: true, opacity: 0.6
  }));
  scene.add(stars);
}

function createVRIndicator() {
  const group = new THREE.Group();
  const ring = new THREE.Mesh(
    new THREE.RingGeometry(0.16, 0.22, 32),
    new THREE.MeshBasicMaterial({
      color: 0xef4444, transparent: true, opacity: 0,
      side: THREE.DoubleSide, depthWrite: false, blending: THREE.AdditiveBlending
    })
  );
  ring.rotation.x = -Math.PI / 2;
  group.add(ring);

  const sphere = new THREE.Mesh(
    new THREE.SphereGeometry(0.06, 12, 10),
    new THREE.MeshBasicMaterial({
      color: 0xef4444, transparent: true, opacity: 0,
      depthWrite: false, blending: THREE.AdditiveBlending
    })
  );
  group.add(sphere);
  group.position.set(0, 2.0, -1.5);
  group.visible = false;
  scene.add(group);
  vrIndicator = { group, ring, sphere };
}

function onResize() {
  const box = $('viewer');
  if (!box || !cam || !ren) return;
  cam.aspect = box.clientWidth / box.clientHeight;
  cam.updateProjectionMatrix();
  ren.setSize(box.clientWidth, box.clientHeight);
  if (composer) composer.setSize(box.clientWidth, box.clientHeight);
}

function checkXR() {
  if (!navigator.xr) {
    $('xrHint').textContent = 'WebXR not available';
    return;
  }
  navigator.xr.isSessionSupported('immersive-vr').then(ok => {
    $('xrHint').textContent = ok
      ? 'WebXR ready • Open in Quest Browser (HTTPS)'
      : 'Immersive VR not supported on this device';
  }).catch(() => {
    $('xrHint').textContent = 'Open in Quest Browser over HTTPS';
  });
}

async function toggleVR() {
  if (ren.xr.isPresenting) {
    const s = ren.xr.getSession();
    if (s) await s.end();
    return;
  }
  try {
    const ok = await navigator.xr.isSessionSupported('immersive-vr');
    if (!ok) { show('Immersive VR not available'); return; }
    const session = await navigator.xr.requestSession('immersive-vr', {
      optionalFeatures: ['local-floor', 'bounded-floor']
    });
    await ren.xr.setSession(session);
    show('VR live');
  } catch (e) {
    show('Open in Quest Browser over HTTPS');
  }
}

// ===================== CONTROLLERS =====================
function onSelectStart(c) {
  c.userData.selecting = true;

  // Hold detection for VR recording
  if (ren.xr.isPresenting) {
    c.userData.holdTimer = setTimeout(() => {
      toggleVRRecording();
    }, 600);
  }

  const active = controllers.filter(x => x.userData.selecting);
  if (active.length === 1) {
    grabState.active = c;
    const p = new THREE.Vector3();
    c.getWorldPosition(p);
    grabState.offset.copy(p).sub(holoRoot.position);
  }
  if (active.length === 2) {
    grabState.lastDist = controllers[0].position.distanceTo(controllers[1].position);
  }
}

function onSelectEnd(c) {
  c.userData.selecting = false;
  if (c.userData.holdTimer) {
    clearTimeout(c.userData.holdTimer);
    c.userData.holdTimer = null;
  }
  if (!controllers.some(x => x.userData.selecting)) releaseGrab();
}

function releaseGrab() {
  grabState.active = null;
  grabState.lastDist = 0;
}

function updateGrab() {
  if (!ren.xr.isPresenting) return;
  const active = controllers.filter(c => c.userData.selecting);
  if (active.length === 1) {
    const p = new THREE.Vector3();
    active[0].getWorldPosition(p);
    holoRoot.position.lerp(p.sub(grabState.offset), 0.25);
  } else if (active.length === 2) {
    const d = controllers[0].position.distanceTo(controllers[1].position);
    if (grabState.lastDist > 0.01) {
      const ratio = THREE.MathUtils.clamp(d / grabState.lastDist, 0.94, 1.06);
      holoRoot.scale.multiplyScalar(ratio);
      holoRoot.scale.clampScalar(0.3, 3);
    }
    grabState.lastDist = d;
  }
}

// ===================== VR RECORDING =====================
function toggleVRRecording() {
  if (!ren.xr.isPresenting) return;
  if (vrRecording) stopVRRecording();
  else startVRRecording();
}

function startVRRecording() {
  vrFrames = [];
  vrRecording = true;

  if (vrIndicator) {
    vrIndicator.group.visible = true;
    vrIndicator.ring.material.opacity = 0.7;
    vrIndicator.sphere.material.opacity = 0.9;
  }

  show('VR Recording started • Hold trigger again to stop');
  $('status').textContent = 'Recording hologram in VR...';

  vrRecordInterval = setInterval(captureVRFrame, 33);
}

function stopVRRecording() {
  vrRecording = false;
  if (vrRecordInterval) {
    clearInterval(vrRecordInterval);
    vrRecordInterval = null;
  }

  if (vrIndicator) {
    vrIndicator.group.visible = false;
    vrIndicator.ring.material.opacity = 0;
    vrIndicator.sphere.material.opacity = 0;
  }

  if (vrFrames.length > 0) {
    frames = vrFrames.map(f => ({
      vertices: f.v,
      colors: f.c,
      meta: f.meta || 0.4,
      layers: layerN,
      spread: layerSp
    }));
    rec = vrFrames;
    playIdx = 0;
    isPlay = true;
    $('playBtn').textContent = 'Pause';
    $('scrub').max = Math.max(0, frames.length - 1);
    $('scrub').value = 0;
    $('scrubV').textContent = '0/' + Math.max(0, frames.length - 1);
    $('nFrm').textContent = frames.length;
    $('status').textContent = `VR Hologram • ${frames.length} frames`;
    drawFrame(0, metaV);
    show(`VR Hologram saved • ${frames.length} frames`);
  } else {
    show('Recording cancelled');
  }
}

function captureVRFrame() {
  if (!vrRecording || !layers.length) return;
  try {
    const source = layers[0];
    if (!source?.geometry?.attributes?.position) return;

    const posAttr = source.geometry.attributes.position;
    const colAttr = source.geometry.attributes.color;
    const count = posAttr.count;
    const step = count > 7000 ? 2 : 1;
    const v = [], c = [];

    for (let i = 0; i < count; i += step) {
      v.push(
        +posAttr.array[i*3].toFixed(3),
        +posAttr.array[i*3+1].toFixed(3),
        +posAttr.array[i*3+2].toFixed(3)
      );
      if (colAttr) {
        c.push(
          +colAttr.array[i*3].toFixed(2),
          +colAttr.array[i*3+1].toFixed(2),
          +colAttr.array[i*3+2].toFixed(2)
        );
      } else c.push(0.6, 0.4, 0.9);
    }

    vrFrames.push({
      v, c,
      meta: 0.35 + Math.random() * 0.2,
      layers: layerN,
      spread: layerSp
    });

    if (vrFrames.length >= 90) stopVRRecording();

    if (vrIndicator?.sphere) {
      vrIndicator.sphere.scale.setScalar(1.4);
      setTimeout(() => {
        if (vrIndicator?.sphere) vrIndicator.sphere.scale.setScalar(1);
      }, 70);
    }
  } catch (e) {}
}

// ===================== CAMERA =====================
function stopStream() {
  if (stream) {
    stream.getTracks().forEach(t => t.stop());
    stream = null;
  }
  ready = false;
}

function initCam(face) {
  video = $('vid');
  c2d = document.createElement('canvas');
  ctx = c2d.getContext('2d', { willReadFrequently: true });
  stopStream();

  if (!navigator.mediaDevices?.getUserMedia) {
    $('status').textContent = 'Camera API unavailable';
    return;
  }

  navigator.mediaDevices.getUserMedia({
    video: { facingMode: { ideal: face }, width: { ideal: 1280 }, height: { ideal: 720 } },
    audio: false
  }).then(s => {
    stream = s;
    facing = face;
    video.srcObject = s;
    return video.play();
  }).then(() => {
    ready = true;
    $('camBtn').textContent = face === 'environment' ? 'Back Cam' : 'Front Cam';
    $('status').textContent = 'Quantum Sensor Online';
  }).catch(() => {
    if (face !== 'user') initCam('user');
    else $('status').textContent = 'Camera error';
  });
}

function switchCam() {
  initCam(facing === 'user' ? 'environment' : 'user');
}

function togglePerf() {
  perf = !perf;
  if (perf) {
    stepSize = 3; layerN = 8; ptSize = 0.02;
    $('step').value = 3; $('stepV').textContent = '3';
    $('layers').value = 8; $('layV').textContent = '8';
    $('psize').value = 0.02;
    $('perfBtn').textContent = 'Warp ON';
    $('perfBtn').style.background = '#10b981';
  } else {
    stepSize = 2; layerN = 14; ptSize = 0.014;
    $('step').value = 2; $('stepV').textContent = '2';
    $('layers').value = 14; $('layV').textContent = '14';
    $('psize').value = 0.014;
    $('perfBtn').textContent = 'Warp';
    $('perfBtn').style.background = '';
  }
  buildChips();
  updSize();
  saveSettings();
}

function resetCam() {
  if (ren.xr.isPresenting) {
    holoRoot.position.set(0, 1.3, -1.7);
    holoRoot.scale.setScalar(0.75);
    holoRoot.rotation.set(0,0,0);
    show('Recentered in VR');
  } else {
    cam.position.set(0, 0.6, 4.2);
    if (ctrl) { ctrl.target.set(0,0,0); ctrl.update(); }
    holoRoot.position.set(0,0,0);
    holoRoot.rotation.set(0,0,0);
    holoRoot.scale.setScalar(1);
    show('Centered');
  }
}

// ===================== MAIN LOOP =====================
function loop(now = performance.now()) {
  if (ctrl && !exporting && !ren.xr.isPresenting) {
    ctrl.autoRotate = !!autoOrbit;
    ctrl.update();
  }

  phase = now * 0.001;
  if (stars) stars.rotation.y = phase * 0.015;

  // VR indicator pulse
  if (vrRecording && vrIndicator) {
    const t = phase;
    vrIndicator.ring.rotation.z = t * 2;
    vrIndicator.ring.material.opacity = 0.5 + Math.sin(t * 6) * 0.25;
    vrIndicator.sphere.material.opacity = 0.7 + Math.sin(t * 8) * 0.25;
  }

  fc++;
  if (now - ft > 1000) {
    $('fpsD').textContent = Math.round(fc * 1000 / (now - ft));
    fc = 0; ft = now;
  }

  // Allow sampling even in VR now (important fix)
  const needSample = ready && video && video.readyState >= 2 && !exporting && !isPlay;
  if (needSample && (now - lastVol > VOL_MS)) {
    lastVol = now;
    sample();
  }

  if (doPulse && layers.length && !exporting) {
    for (let i = 0; i < layers.length; i++) {
      const o = layers[i];
      if (o && o.visible) {
        const s = 1 + Math.sin(phase * 3 + i * 0.2) * 0.018;
        o.scale.setScalar(s);
      }
    }
  }

  if (isPlay && frames.length && !exporting && (now - lastT > 1000 / playFPS)) {
    drawFrame(playIdx, metaV);
    playIdx = (playIdx + 1) % frames.length;
    $('scrub').value = playIdx;
    $('scrubV').textContent = playIdx + '/' + Math.max(0, frames.length - 1);
    lastT = now;
  }

  updateGrab();

  if (composer && !exporting && !ren.xr.isPresenting) composer.render();
  else ren.render(scene, cam);
}

// ===================== SAMPLING =====================
function sample() {
  const w = video.videoWidth || 640;
  const h = video.videoHeight || 480;
  if (c2d.width !== w || c2d.height !== h) {
    c2d.width = w; c2d.height = h;
  }
  try { ctx.drawImage(video, 0, 0, w, h); } catch { return; }
  let pix;
  try { pix = ctx.getImageData(0, 0, w, h).data; } catch { return; }

  const pos = [], col = [];
  const cx = w * 0.5, cy = h * 0.5, maxR = Math.hypot(cx, cy) || 1;
  const sx = 1.5 * Math.min(w / Math.max(h, 1), 1.5), sy = 1.5;
  const maxP = perf ? 28000 : 65000;
  const step = Math.max(1, stepSize | 0);
  const thr = 0.009;

  for (let y = 0; y < h && pos.length / 3 < maxP; y += step) {
    for (let x = 0; x < w && pos.length / 3 < maxP; x += step) {
      const i = (y * w + x) * 4;
      const r = pix[i]/255, g = pix[i+1]/255, b = pix[i+2]/255;
      const lum = 0.299*r + 0.587*g + 0.114*b;
      if (lum < thr) continue;

      const nx = ((w - x)/w)*2 - 1;
      const ny = -((y/h)*2 - 1);
      const dx = (x - cx)/maxR, dy = (y - cy)/maxR;
      const rad = dx*dx + dy*dy;
      let nz = (lum - 0.18) * (depthMul * 0.036) - rad * 0.4;

      if (rMode === 'quantumWave') nz += Math.sin(nx * 6 + phase * 4) * 0.2;
      else if (rMode === 'plasmaVortex') {
        const ang = Math.atan2(dy, dx) + phase * 2;
        nz += Math.sin(ang * 4) * 0.25;
      }

      pos.push(nx * sx, ny * sy, nz);
      const avg = (r+g+b)/3;
      col.push(
        Math.min(1, avg + (r-avg)*1.4 + 0.15),
        Math.min(1, avg + (g-avg)*1.3 + 0.1),
        Math.min(1, avg + (b-avg)*1.5 + 0.3)
      );
    }
  }

  const n = pos.length / 3;
  $('nLive').textContent = n.toLocaleString();
  $('nodesD').textContent = (n * layerN).toLocaleString();
  buildLayers(pos, col);

  if (scanning) {
    const v = [];
    for (let i = 0; i < pos.length; i += 3) {
      v.push(+pos[i].toFixed(3), +pos[i+1].toFixed(3), +pos[i+2].toFixed(3));
    }
    rec.push({
      v,
      c: col.map(x => +x.toFixed(2)),
      meta: 0.3 + Math.random()*0.2,
      layers: layerN,
      spread: layerSp
    });
    fIdx++;
    $('nFrm').textContent = rec.length;
    if (fIdx % 4 === 0) {
      $('jsonOut').value = JSON.stringify({
        HyperStreamXD: rec, layers: layerN, spread: layerSp
      });
    }
  }
}

function clearLayers() {
  for (const o of layers) {
    if (!o) continue;
    holoRoot.remove(o);
    if (o.geometry) o.geometry.dispose();
    if (o.material) o.material.dispose();
  }
  layers = [];
  prevPos = [];
}

function buildLayers(basePos, baseCol) {
  while (layers.length > layerN) {
    const o = layers.pop();
    if (o) {
      holoRoot.remove(o);
      if (o.geometry) o.geometry.dispose();
      if (o.material) o.material.dispose();
    }
    prevPos.pop();
  }

  const n = basePos.length / 3;
  if (n < 4) return;
  const maxL = Math.max(1, layerN - 1);
  const mOff = metaV * 0.35;

  for (let L = 0; L < layerN; L++) {
    const t = L / maxL;
    const zOff = (t - 0.5) * layerSp * 1.7;
    const front = 1 - t;
    const pos = new Float32Array(n * 3);
    const col = new Float32Array(n * 3);

    for (let i = 0, j = 0; i < n; i++, j += 3) {
      let px = basePos[j];
      let py = basePos[j+1] + mOff*(0.5 + L*0.03);
      let pz = basePos[j+2] + zOff;

      if (prevPos[L] && prevPos[L].length === pos.length && smooth > 0.05) {
        const p = prevPos[L], k = smooth;
        px = px*(1-k) + p[j]*k;
        py = py*(1-k) + p[j+1]*k;
        pz = pz*(1-k) + p[j+2]*k;
      }
      pos[j] = px; pos[j+1] = py; pos[j+2] = pz;

      const bcR = baseCol[j] ?? 0.5;
      const bcG = baseCol[j+1] ?? 0.4;
      const bcB = baseCol[j+2] ?? 0.9;
      col[j]   = Math.min(1, bcR * (0.8 + front*0.2));
      col[j+1] = Math.min(1, bcG * (0.8 + L*0.015));
      col[j+2] = Math.min(1, bcB * (0.7 + (1-front)*0.3));
    }

    prevPos[L] = pos;
    const size = ptSize * (1.12 - L * 0.025);
    const op = Math.max(0.3, 0.92 - L * 0.045);

    let o = layers[L];
    if (!o) {
      const g = new THREE.BufferGeometry();
      g.setAttribute('position', new THREE.BufferAttribute(pos, 3));
      g.setAttribute('color', new THREE.BufferAttribute(col, 3));
      o = new THREE.Points(g, new THREE.PointsMaterial({
        size, sizeAttenuation: true, vertexColors: true,
        transparent: true, opacity: op, depthWrite: false,
        blending: THREE.AdditiveBlending
      }));
      holoRoot.add(o);
      layers[L] = o;
    } else {
      const oldN = o.geometry.attributes.position?.count || 0;
      if (oldN !== n) {
        o.geometry.setAttribute('position', new THREE.BufferAttribute(pos, 3));
        o.geometry.setAttribute('color', new THREE.BufferAttribute(col, 3));
      } else {
        o.geometry.attributes.position.array.set(pos);
        o.geometry.attributes.color.array.set(col);
        o.geometry.attributes.position.needsUpdate = true;
        o.geometry.attributes.color.needsUpdate = true;
      }
      o.material.size = size;
      o.material.opacity = op;
    }
    o.visible = vis[L] !== false;
  }
}

function updSize() {
  layers.forEach((o, L) => {
    if (o?.material) o.material.size = ptSize * (1.12 - L * 0.025);
  });
}

// ===================== CONTROLS =====================
function toggleScan() {
  scanning = !scanning;
  const b = $('scanBtn');
  if (scanning) {
    rec = []; fIdx = 0; frames = []; isPlay = false;
    $('playBtn').textContent = 'Play';
    b.textContent = 'STOP MATRIX SCAN';
    b.classList.add('on');
    $('status').textContent = 'Recording 4D Matrix…';
  } else {
    b.textContent = 'ACTIVATE 4D MATRIX SCAN';
    b.classList.remove('on');
    $('status').textContent = 'Scan Complete';
    $('jsonOut').value = JSON.stringify({
      HyperStreamXD: rec, layers: layerN, spread: layerSp
    });
    if (rec.length) {
      loadData({ HyperStreamXD: rec, layers: layerN, spread: layerSp });
      $('expStatus').textContent = rec.length + ' frames locked';
    }
  }
}

function mode(m) {
  ['cap','load'].forEach(x => {
    $('t-'+x).classList.toggle('on', x === m);
    $('p-'+x).style.display = x === m ? 'flex' : 'none';
  });
}

function buildChips() {
  const c = $('chips');
  if (!c) return;
  c.innerHTML = '';
  for (let i = 0; i < layerN; i++) {
    if (vis[i] === undefined) vis[i] = true;
    const d = document.createElement('div');
    d.className = 'chip' + (vis[i] ? ' on' : '');
    d.textContent = 'S' + (i+1);
    d.onclick = () => {
      vis[i] = !vis[i];
      if (layers[i]) layers[i].visible = vis[i];
      d.classList.toggle('on', vis[i]);
    };
    c.appendChild(d);
  }
}

function toNum(a) {
  if (!a) return [];
  return Array.from(a).map(Number).filter(n => isFinite(n));
}

function extract(data) {
  if (!data) return null;
  let raw = data.HyperStreamXD || data.HyperStream4D || data.HyperStream5D || (Array.isArray(data) ? data : null);
  if (!raw) {
    const k = Object.keys(data).find(x => Array.isArray(data[x]));
    if (k) raw = data[k];
  }
  if (!raw) return null;
  return raw.map(f => ({
    vertices: toNum(f.v || f.vertices || []),
    colors: toNum(f.c || f.colors || []),
    meta: typeof f.meta === 'number' ? f.meta : 0.5,
    layers: f.layers || data.layers || layerN,
    spread: f.spread !== undefined ? f.spread : (data.spread || layerSp)
  })).filter(f => f.vertices.length > 0);
}

function drawFrame(idx, meta) {
  if (!frames.length) return;
  const f = frames[idx % frames.length];
  const src = f.vertices;
  const cols = f.colors;
  const Lc = f.layers || layerN;
  const sp = f.spread !== undefined ? f.spread : layerSp;
  const ts = (src.length % 4 === 0) ? 4 : 3;
  const pos = [], col = [];

  for (let i = 0; i < src.length; i += ts) {
    pos.push(src[i], src[i+1] + (f.meta || 0.5) * meta * 0.35, src[i+2]);
    const ci = (i / ts) * 3;
    if (cols.length >= ci + 3) col.push(cols[ci], cols[ci+1], cols[ci+2]);
    else col.push(0.5, 0.4, 0.9);
  }

  const prevN = layerN, prevS = layerSp;
  layerN = Lc; layerSp = sp;

  if (rMode === 'points' || rMode === 'quantumWave' || rMode === 'plasmaVortex') {
    buildLayers(pos, col);
  } else {
    clearLayers();
    const g = new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.BufferAttribute(new Float32Array(pos), 3));
    g.setAttribute('color', new THREE.BufferAttribute(new Float32Array(col), 3));
    const count = pos.length / 3;
    const side = Math.floor(Math.sqrt(count));
    if (side > 4) {
      const idxArr = [];
      for (let y = 0; y < side-1; y++) {
        for (let x = 0; x < side-1; x++) {
          const i = y*side + x;
          if (i + side + 1 < count) {
            idxArr.push(i, i+1, i+side, i+1, i+side+1, i+side);
          }
        }
      }
      if (idxArr.length) g.setIndex(idxArr);
    }
    g.computeVertexNormals();
    const mesh = new THREE.Mesh(g, new THREE.MeshStandardMaterial({
      vertexColors: true, roughness: 0.2, metalness: 0.3,
      wireframe: rMode === 'wire', side: THREE.DoubleSide
    }));
    mesh.rotation.y = Math.PI;
    holoRoot.add(mesh);
    layers = [mesh];
  }

  layerN = prevN; layerSp = prevS;
  $('nodesD').textContent = ((pos.length/3)*Lc).toLocaleString();
}

function loadData(data) {
  const seq = extract(data);
  if (!seq || !seq.length) {
    $('status').textContent = 'Invalid Matrix';
    return;
  }
  frames = seq;
  playIdx = 0;
  isPlay = true;
  $('playBtn').textContent = 'Pause';
  if (data.layers) layerN = data.layers;
  if (data.spread) layerSp = data.spread;
  $('layers').value = layerN;
  $('layV').textContent = layerN;
  $('spread').value = layerSp;
  $('scrub').max = Math.max(0, seq.length-1);
  $('scrub').value = 0;
  $('scrubV').textContent = '0/' + Math.max(0, seq.length-1);
  drawFrame(0, metaV);
  $('status').textContent = 'Hologram Loaded · ' + seq.length + ' frames';
  buildChips();
  show('Hologram loaded');
}

function clearAll() {
  isPlay = false;
  frames = [];
  playIdx = 0;
  clearLayers();
  $('nodesD').textContent = '0';
  $('nLive').textContent = '0';
  $('status').textContent = 'Environment Purged';
  $('playBtn').textContent = 'Play';
  $('scrub').max = 0;
  $('scrubV').textContent = '0/0';
  $('expStatus').textContent = 'Ready';
}

function togglePlay() {
  if (!frames.length) return;
  isPlay = !isPlay;
  $('playBtn').textContent = isPlay ? 'Pause' : 'Play';
}

function setProg(p) {
  $('progFill').style.width = Math.min(100, Math.max(0, p)) + '%';
}

function expJSON() {
  if (!rec.length && !frames.length) return;
  const payload = rec.length
    ? { HyperStreamXD: rec, layers: layerN, spread: layerSp }
    : { HyperStreamXD: frames, layers: layerN, spread: layerSp };
  const blob = new Blob([JSON.stringify(payload)], { type: 'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'hyperstream_' + Date.now() + '.json';
  a.click();
}

function copyJSON() {
  const t = $('jsonOut').value;
  if (t) navigator.clipboard.writeText(t).catch(()=>{});
}

function expPNG() {
  if (!layers.length) return;
  if (composer && !ren.xr.isPresenting) composer.render();
  else ren.render(scene, cam);
  const a = document.createElement('a');
  a.href = $('c3').toDataURL('image/png');
  a.download = 'hologram_' + Date.now() + '.png';
  a.click();
}

function expVideo() {
  if (exporting) return;
  if (!layers.length && !frames.length) {
    $('expStatus').textContent = 'Nothing to record';
    return;
  }
  if (typeof MediaRecorder === 'undefined' || !HTMLCanvasElement.prototype.captureStream) {
    $('expStatus').textContent = 'Recording not supported';
    return;
  }

  const mime = MediaRecorder.isTypeSupported('video/webm;codecs=vp9')
    ? 'video/webm;codecs=vp9' : 'video/webm';
  const btn = $('webmBtn');
  btn.disabled = true;
  exporting = true;
  isPlay = false;
  $('playBtn').textContent = 'Play';
  $('expStatus').textContent = 'Recording 8 seconds…';
  setProg(0);

  const wasOrbit = autoOrbit;
  autoOrbit = false;
  if (ctrl) { ctrl.autoRotate = false; ctrl.enabled = false; }

  const stream = $('c3').captureStream(30);
  const recorder = new MediaRecorder(stream, { mimeType: mime, videoBitsPerSecond: 6000000 });
  const chunks = [];

  recorder.ondataavailable = e => { if (e.data.size > 0) chunks.push(e.data); };
  recorder.onstop = () => {
    const blob = new Blob(chunks, { type: 'video/webm' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'hyperstream_4d_' + Date.now() + '.webm';
    a.click();
    $('expStatus').textContent = 'Video saved (' + Math.round(blob.size/1024) + ' KB)';
    setProg(100);
    exporting = false;
    btn.disabled = false;
    autoOrbit = wasOrbit;
    if (ctrl) { ctrl.autoRotate = autoOrbit; ctrl.enabled = true; }
  };

  try {
    recorder.start(100);
  } catch(e) {
    $('expStatus').textContent = 'Failed to start';
    exporting = false;
    btn.disabled = false;
    return;
  }

  let progress = 0;
  const iv = setInterval(() => {
    progress += 12.5;
    setProg(Math.min(progress, 99));
  }, 1000);

  setTimeout(() => {
    clearInterval(iv);
    if (recorder.state !== 'inactive') recorder.stop();
  }, 8000);
}

function dropInit() {
  const d = $('drop');
  if (!d) return;
  ['dragenter','dragover'].forEach(e => d.addEventListener(e, ev => {
    ev.preventDefault(); d.classList.add('over');
  }));
  ['dragleave','drop'].forEach(e => d.addEventListener(e, ev => {
    ev.preventDefault(); d.classList.remove('over');
  }));
  d.addEventListener('drop', e => {
    const f = e.dataTransfer.files[0];
    if (f) readF(f);
  });
}

function readF(f) {
  const r = new FileReader();
  r.onload = e => {
    try { loadData(JSON.parse(e.target.result)); }
    catch { $('status').textContent = 'Bad file'; }
  };
  r.readAsText(f);
}

function fileIn(e) {
  if (e.target.files[0]) readF(e.target.files[0]);
}

function saveSettings() {
  const s = { stepSize, depthMul, ptSize, layerN, layerSp, metaV, rMode };
  localStorage.setItem('hs_settings', JSON.stringify(s));
}

function loadSettings() {
  try {
    const s = JSON.parse(localStorage.getItem('hs_settings') || '{}');
    if (s.stepSize) { stepSize = s.stepSize; $('step').value = stepSize; $('stepV').textContent = stepSize; }
    if (s.depthMul) { depthMul = s.depthMul; $('depth').value = depthMul; }
    if (s.ptSize) { ptSize = s.ptSize; $('psize').value = ptSize; }
    if (s.layerN) { layerN = s.layerN; $('layers').value = layerN; $('layV').textContent = layerN; }
    if (s.layerSp) { layerSp = s.layerSp; $('spread').value = layerSp; }
    if (s.metaV) { metaV = s.metaV; $('meta').value = metaV*100; $('metaV').textContent = metaV.toFixed(2); }
    if (s.rMode) { rMode = s.rMode; $('rmode').value = rMode; }
  } catch(e) {}
}

function show(t) {
  const e = $('toast');
  e.textContent = t;
  e.classList.add('show');
  clearTimeout(show.t);
  show.t = setTimeout(() => e.classList.remove('show'), 1800);
}
